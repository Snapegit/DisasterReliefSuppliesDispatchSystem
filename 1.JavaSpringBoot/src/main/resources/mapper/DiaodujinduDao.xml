<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.DiaodujinduDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.DiaodujinduEntity" id="diaodujinduMap">
        <result property="diaodubianhao" column="diaodubianhao"/>
        <result property="wuzimingcheng" column="wuzimingcheng"/>
        <result property="wuzizhonglei" column="wuzizhonglei"/>
        <result property="shuliang" column="shuliang"/>
        <result property="yunshufangshi" column="yunshufangshi"/>
        <result property="yonghuzhanghao" column="yonghuzhanghao"/>
        <result property="yonghuxingming" column="yonghuxingming"/>
        <result property="dianhuahaoma" column="dianhuahaoma"/>
        <result property="dizhi" column="dizhi"/>
        <result property="wuliuzhuangtai" column="wuliuzhuangtai"/>
        <result property="wuliuxiangqing" column="wuliuxiangqing"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.DiaodujinduView" >

		SELECT  diaodujindu.* FROM diaodujindu  diaodujindu 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.DiaodujinduView" >
		SELECT * FROM diaodujindu  diaodujindu <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
