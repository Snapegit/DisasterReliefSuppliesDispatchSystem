<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.DiaoduyuanDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.DiaoduyuanEntity" id="diaoduyuanMap">
        <result property="diaoduyuangonghao" column="diaoduyuangonghao"/>
        <result property="diaoduyuanmima" column="diaoduyuanmima"/>
        <result property="diaoduyuanxingming" column="diaoduyuanxingming"/>
        <result property="touxiang" column="touxiang"/>
        <result property="lianxifangshi" column="lianxifangshi"/>
        <result property="shenfenzhenghao" column="shenfenzhenghao"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.DiaoduyuanView" >

		SELECT  diaoduyuan.* FROM diaoduyuan  diaoduyuan 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.DiaoduyuanView" >
		SELECT * FROM diaoduyuan  diaoduyuan <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
