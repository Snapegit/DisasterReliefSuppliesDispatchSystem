<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.WuzichukuDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.WuzichukuEntity" id="wuzichukuMap">
        <result property="wuzimingcheng" column="wuzimingcheng"/>
        <result property="wuzizhonglei" column="wuzizhonglei"/>
        <result property="shuliang" column="shuliang"/>
        <result property="chukuren" column="chukuren"/>
        <result property="chukushijian" column="chukushijian"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.WuzichukuView" >

		SELECT  wuzichuku.* FROM wuzichuku  wuzichuku 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.WuzichukuView" >
		SELECT * FROM wuzichuku  wuzichuku <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
